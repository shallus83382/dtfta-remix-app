{% schema %}
{
  "name": "DTFTA cart interceptor",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/dtfta/"
    }
  ]
}
{% endschema %}

<script>
  window.__DTFTA__ = {
    enabled: true,
    proxyPath: {{ block.settings.proxy_path | json }},
    shop: {{ shop.permanent_domain | json }},
    templateId: {{ product.metafields.dtfta.template_id.value | default: product.metafields.dtfta.template_id | json }}
  };
</script>

{{ 'dtfta-storefront.js' | asset_url | script_tag }}